ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./backend/data/careguide.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=backend/data/uploads
PROCESSED_DIR=backend/data/processed
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=20
# Optional model-assisted invoice extraction: none, ollama, or gemini.
# Ollama stays local. Gemini sends extracted document text to Google's API.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
INVOICE_ROUNDING_TOLERANCE=0.02
ALLOW_NEGATIVE_INVOICE_AMOUNTS=false
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=900
WORKER_STALE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=true
SEMANTIC_MAX_DOCUMENTS=5000
SEARCH_INDEX_MAX_CHARS=1000000
MAX_UPLOAD_BYTES=52428800
MAX_BATCH_FILES=20
MAX_PDF_PAGES=1000
MIN_PDF_TEXT_CHARS=24
MAX_SPREADSHEET_ROWS=100000
MAX_CSV_ROWS=250000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
MAX_IMAGE_PIXELS=50000000
PROCESSING_TIMEOUT_SECONDS=600
OCR_TIMEOUT_SECONDS=30
OCR_DPI=200
OCR_LANGUAGE=eng
# Optional if Tesseract is not on PATH:
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
